    poly: builtins.str,
    modulus: builtins.int,
    power: typing.Optional[tuple[builtins.int, Expression]] = None,
    default_namespace: typing.Optional[builtins.str] = None,
    minimal_poly: typing.Optional[Polynomial] = None,
