    >>> cosh = S(
    >>>     "my_cosh",
    >>>     eval={
    >>>         "float": lambda args: math.cosh(args[0]),
    >>>         "complex": lambda args: cmath.cosh(args[0]),
    >>>         "cpp": "template<typename T> T python_my_cosh(T a) { return std::cosh(a); }",
